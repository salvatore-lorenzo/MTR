           RowBox[{
            RowBox[{"Eigenvectors", "[", "#", "]"}], "&"}], "/@", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Z"}], "}"}], ",", 
             RowBox[{"Table", "[", 
