        RowBox[{"MultinomialDistribution", "[", 
         RowBox[{"stat", ",", "v"}], "]"}], ",", "1"}], "]"}], "/", "stat"}], 
     "//", "Flatten"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
