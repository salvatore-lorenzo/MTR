Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"X", ",", "Z", ",", "MUB"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MUB", "[", "dim_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X", ",", "Z"}], "}"}], ",", 
     RowBox[{
      RowBox[{"X", "=", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", 
              RowBox[{"UnitVector", "[", 
               RowBox[{"dim", ",", "1"}], "]"}], ",", 
              RowBox[{"UnitVector", "[", 
               RowBox[{"dim", ",", "dim"}], "]"}]}], "]"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Outer", "[", 
              RowBox[{"Times", ",", 
               RowBox[{"UnitVector", "[", 
                RowBox[{"dim", ",", 
                 RowBox[{"#", "+", "1"}]}], "]"}], ",", 
               RowBox[{"UnitVector", "[", 
                RowBox[{"dim", ",", "#"}], "]"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{"1", ",", 
              RowBox[{"dim", "-", "1"}]}], "]"}]}]}], "]"}], "]"}], "//", 
        "N"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Z", "=", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"E", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"2", " ", "\[Pi]", " ", "I"}], ")"}], "/", "dim"}], " ",
                "#"}], ")"}]}], " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", 
              RowBox[{"UnitVector", "[", 
               RowBox[{"dim", ",", "#"}], "]"}], ",", 
              RowBox[{"UnitVector", "[", 
               RowBox[{"dim", ",", "#"}], "]"}]}], "]"}]}], "&"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "dim"}], "]"}]}], "]"}], "//", "N"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", "#", ",", 
            RowBox[{"#", "\[Conjugate]"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"dim", "+", "1"}], ")"}]}], "&"}], "/@", 
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Eigenvectors", "[", "#", "]"}], "&"}], "/@", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"X", ",", "Z"}], "}"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"X", ".", 
                RowBox[{"MatrixPower", "[", 
                 RowBox[{"Z", ",", "k"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", 
                 RowBox[{"dim", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ",", 
          "1"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dirtmulinomial", "[", 
    RowBox[{
     RowBox[{"v_", "?", "VectorQ"}], ",", "stat_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"RandomVariate", "[", 
